{
  "name": "tatuagem-gh-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-01",
  // GITHUB_TOKEN e ADMIN_PASSWORD NÃO ficam aqui — são configurados como
  // secrets via linha de comando (veja README.md), pra nunca aparecer
  // em texto puro em nenhum arquivo commitado.
  "ratelimits": [
    {
      // Protege ADMIN_PASSWORD (a chave-mestra de escrita do repo) contra
      // força bruta: no máximo 5 tentativas por IP a cada 60s. Requer
      // Wrangler >= 4.36.0 — ver README.md.
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
